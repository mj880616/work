<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BasketDrop</AssemblyName>
    <RootNamespace>BasketDrop.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.2.5</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BasketDrop.Core\BasketDrop.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="BasketDrop.app.ico" />
    <EmbeddedResource Include="tray-pending.ico" LogicalName="BasketDrop.tray-pending.ico" />
    <EmbeddedResource Include="tray-signedout.ico" LogicalName="BasketDrop.tray-signedout.ico" />
    <EmbeddedResource Include="tray-signedout-pending.ico" LogicalName="BasketDrop.tray-signedout-pending.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
