<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 권한은 인터넷 하나. 사진·저장소 전체 읽기, 앱 설치 권한은 요청하지 않는다(설계 5.2·6.3). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- MTG-폰녹음(0.3.3): [녹음]에만 쓰는 마이크·앞쪽 서비스(마이크)·알림. 마이크·알림은 처음 녹음할 때만 묻는다. 저장소 권한은 없다(앱 전용 공간만). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:label="웹2"
        android:icon="@drawable/app_icon"
        android:roundIcon="@drawable/app_icon"
        android:theme="@style/AppTheme">
        <!-- singleTask: 로그인 복귀(kptuwork://auth)가 오면 위에 떠 있던 브라우저 탭을 닫고 이 화면으로 돌아온다. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kptuwork" android:host="auth" />
            </intent-filter>
            <!-- 단계 ②: 다른 앱의 [공유]에 "웹2 바구니"로 보인다. 글·링크·사진·파일. 받은 항목의 임시 읽기 권한만 쓴다(저장소 권한 없음). -->
            <intent-filter android:label="웹2 바구니">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="웹2 바구니">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- 단계 ③: 위젯 [로그인] 줄만 여는 화면. 내보내지 않아 다른 앱은 열 수 없다. 그리지 않고 바로 닫는다. -->
        <activity
            android:name=".WidgetLoginActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- MTG-폰녹음: 알림줄 [멈추고 정리]·녹음 시작 인텐트(홈 위젯 [녹음] 칸 자리)를 받는 화면. 내보내지 않아 다른 앱은 열 수 없다. 그리지 않고 바로 닫는다. -->
        <activity
            android:name=".RecordActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- MTG-폰녹음: 화면이 꺼져도 녹음을 잇는 앞쪽 서비스(마이크). 내보내지 않는다. -->
        <service
            android:name=".RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- WIDGET-여러개 ①: 위젯 [사진] 칸. 사진 고르기·카메라 → 공유 받기 길로 정리함. 내보내지 않는다. 저장소·카메라 권한 없음(고른 사진의 임시 읽기, 카메라 앱이 찍어 사진첩에 저장). -->
        <activity
            android:name=".PhotoPickActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- WIDGET-여러개 ①: 한 칸 위젯 기능 고르기. 홈 화면 앱이 열어야 해서 내보내지만 이 앱 위젯 번호의 기능 이름 하나만 저장한다. -->
        <activity
            android:name=".OneWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/WidgetConfigTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- WIDGET-여러개 ①: 빠른 쓰기(4×1). 서버를 읽지 않는다. -->
        <receiver
            android:name=".QuickWidget"
            android:exported="false"
            android:label="웹2 빠른 쓰기">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_widget_info" />
        </receiver>
        <!-- WIDGET-여러개 ①: 한 칸(1×1). 놓을 때 기능을 고른다. 서버를 읽지 않는다. -->
        <receiver
            android:name=".OneWidget"
            android:exported="false"
            android:label="웹2 한 칸">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/one_widget_info" />
        </receiver>
        <!-- WIDGET-여러개 ②: 이번 주 일정(4×2). 오늘 위젯과 같은 위젯 세션·갱신 작업. -->
        <receiver
            android:name=".WeekWidget"
            android:exported="false"
            android:label="웹2 이번 주">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_widget_info" />
        </receiver>
        <!-- WIDGET-여러개 ③: 텔레그램 새 소식(4×2, 운영자 전용, 서버 허용표로만 내용). -->
        <receiver
            android:name=".TelegramWidget"
            android:exported="false"
            android:label="웹2 텔레그램">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/telegram_widget_info" />
        </receiver>
        <!-- WIDGET-여러개 ③: 아스날 다음 경기(2×1). 공개 정적 파일, 로그인 없음. -->
        <receiver
            android:name=".ArsenalWidget"
            android:exported="false"
            android:label="아스날">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/arsenal_widget_info" />
        </receiver>
        <!-- 단계 ③: 홈 화면 '웹2 오늘' 위젯(홈 화면 전용). 권한은 그대로 인터넷 하나. -->
        <receiver
            android:name=".TodayWidget"
            android:exported="false"
            android:label="웹2 오늘">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>
    </application>
</manifest>
