<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 기본 권한은 인터넷. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- PHOTO-출처 ①(0.3.9, 명진 결정 10/30): 사진 메뉴 '폰 사진'만 쓰는 사진·동영상 읽기. 처음 사진 메뉴에서 [사진 접근 허용]을 누를 때만 묻는다.
         안드로이드 14+는 '고른 사진만'(부분 허용)도 받는다. 12 이하는 저장소 읽기. 목록·그림은 폰 안에서만 쓰고 서버로 올리지 않는다(PhoneMedia). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- S48-60 PHOTO-정보고치기: 사진 위치(EXIF GPS)를 가리지 않고 읽고 고치기. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- PHOTO-폴더스위치(0.4.1): 사진 [폴더]의 폰 폴더 바꾸기·지우기. 사용자가 설정에서 '미디어 관리 허용'을 켜면 매번 확인 창을 띄우지 않는다(안 켜면 바꿀 때마다 시스템이 묻는다). -->
    <uses-permission android:name="android.permission.MANAGE_MEDIA" tools:ignore="ProtectedPermissions" />
    <!-- APP-스스로업데이트(0.3.8): 이 앱 자신의 새 판(같은 서명, 공개 릴리스)만 설치한다. 처음 한 번 '이 앱에서 설치 허용'을 사용자가 켠다.
         UPDATE_PACKAGES_WITHOUT_USER_ACTION(안드로이드 14+, 일반 권한)은 이 앱이 설치한 이 앱을 확인 없이 업데이트할 때 쓴다. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- MTG-폰녹음(0.3.3): [녹음]에만 쓰는 마이크·앞쪽 서비스(마이크)·알림. 마이크·알림은 처음 녹음할 때만 묻는다. 저장소 권한은 없다(앱 전용 공간만). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- PHOTO-갤러리편집(0.4.6): 크게 보기 [편집]이 삼성 갤러리 편집기가 있는지 묻는다(안드로이드 11+ 앱 보기 제한). 다른 앱에서 들어오는 의도는 받지 않는다. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.EDIT" />
            <data android:mimeType="image/*" />
        </intent>
        <!-- PHOTO-갤러리편집: 삼성 갤러리로 그 사진 보기(편집 입구가 없을 때). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="image/*" />
        </intent>
        <package android:name="com.sec.android.mimage.photoretouching" />
        <package android:name="com.sec.android.gallery3d" />
    </queries>
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:label="웹2"
        android:icon="@drawable/app_icon"
        android:roundIcon="@drawable/app_icon"
        android:theme="@style/AppTheme">
        <!-- singleTask: 로그인 복귀(kptuwork://auth)가 오면 위에 떠 있던 브라우저 탭을 닫고 이 화면으로 돌아온다. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kptuwork" android:host="auth" />
            </intent-filter>
            <!-- 단계 ②: 다른 앱의 [공유]에 "웹2 정리함"으로 보인다(APP-공유노트할일: 이름을 앱 안 이름 '정리함'으로 맞춤). 글·링크·사진·파일. 받은 항목의 임시 읽기 권한만 쓴다(저장소 권한 없음). -->
            <intent-filter android:label="웹2 정리함">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="웹2 정리함">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- APP-공유노트할일(요청함 11/02 00:22): 공유 창에 '웹2 노트'·'웹2 할 일' 두 칸 더. 새 화면이 아니라 MainActivity의 다른 이름(activity-alias)이고,
             받기 길(ShareIntake)은 정리함과 같다. 받는 것은 SEND·SEND_MULTIPLE뿐, 새 권한 없음. 들어갈 곳은 이 이름으로만 정한다. -->
        <activity-alias
            android:name=".ShareToNote"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="웹2 노트">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ShareToTask"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:label="웹2 할 일">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity-alias>
        <!-- 단계 ③: 위젯 [로그인] 줄만 여는 화면. 내보내지 않아 다른 앱은 열 수 없다. 그리지 않고 바로 닫는다. -->
        <activity
            android:name=".WidgetLoginActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- MTG-폰녹음: 알림줄 [멈추고 정리]·녹음 시작 인텐트(홈 위젯 [녹음] 칸 자리)를 받는 화면. 내보내지 않아 다른 앱은 열 수 없다. 그리지 않고 바로 닫는다. -->
        <activity
            android:name=".RecordActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- APP-폰알림 N4: 서버(phone-push)가 보낸 알림을 받는 서비스. 내보내지 않는다(구글 Play 서비스가 이 앱 안으로만 전달).
             알림 권한(POST_NOTIFICATIONS)은 위 녹음 줄의 선언을 함께 쓴다. 내 프로필 '폰 알림'에서 [이 폰에서 받기]·[시험 알림] 때 한 번 묻는다. -->
        <service
            android:name=".PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- MTG-폰녹음: 화면이 꺼져도 녹음을 잇는 앞쪽 서비스(마이크). 내보내지 않는다. -->
        <service
            android:name=".RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- WIDGET-여러개 ①: 위젯 [사진] 칸. 사진 고르기·카메라 → 공유 받기 길로 정리함. 내보내지 않는다. 저장소·카메라 권한 없음(고른 사진의 임시 읽기, 카메라 앱이 찍어 사진첩에 저장). -->
        <activity
            android:name=".PhotoPickActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- APP-위젯빠른쓰기: 위젯 [업데이트]·[할 일]·[노트]가 바로 여는 작은 입력 창(웹2를 띄우지 않음). 내보내지 않는다. 권한 추가 없음. -->
        <activity
            android:name=".QuickWriteActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/QuickWriteTheme"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />
        <!-- WIDGET-여러개 ①: 한 칸 위젯 기능 고르기. 홈 화면 앱이 열어야 해서 내보내지만 이 앱 위젯 번호의 기능 이름 하나만 저장한다. -->
        <activity
            android:name=".OneWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/WidgetConfigTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- APP-위젯아스날맞춤 E: 아스날 위젯 '결과 보이기/가리기' 고르기. 홈 화면 앱이 열어야 해서 내보내지만 이 앱 위젯 번호의 켬/끔 하나만 저장한다. -->
        <activity
            android:name=".ArsenalWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/WidgetConfigTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- 위젯 규칙(APP-한칸위젯디자인, 11/02): 위젯 받는 곳(receiver)은 지우거나 이름을 바꾸지 않는다. 지우면 홈 화면에 놓아 둔 자리가
             '위젯을 추가할 수 없습니다'로 남고 되살릴 수 없다. 모양을 바꿀 때는 같은 이름으로 새 모양을 그린다(WidgetActionsTest가 이름 목록을 고정). -->
        <!-- APP-위젯다시 ②: 빠른 쓰기(4×1·2×1). 서버를 읽지 않는다. -->
        <receiver
            android:name=".QuickWidget"
            android:exported="false"
            android:label="웹2 빠른 쓰기">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_widget_info" />
        </receiver>
        <!-- WIDGET-여러개 ①: 한 칸(1×1). 놓을 때 기능을 고른다. 서버를 읽지 않는다. -->
        <receiver
            android:name=".OneWidget"
            android:exported="false"
            android:label="웹2 한 칸">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/one_widget_info" />
        </receiver>
        <!-- APP-위젯다시 ③: 이번 주(4×2·4×1). 지금 위젯과 같은 위젯 세션·갱신 작업. -->
        <receiver
            android:name=".WeekWidget"
            android:exported="false"
            android:label="웹2 이번 주">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_widget_info" />
        </receiver>
        <!-- WIDGET-여러개 ③ → APP-위젯아스날맞춤 C: 아스날(4×2·4×1·2×1). 경기는 공개 정적 파일(로그인 없음), 경기 뒤 내 일정은 위젯 로그인이 있을 때만. -->
        <receiver
            android:name=".ArsenalWidget"
            android:exported="false"
            android:label="아스날">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/arsenal_widget_info" />
        </receiver>
        <!-- APP-스스로업데이트: PackageInstaller 결과와 새 판으로 바뀜(MY_PACKAGE_REPLACED). 내보내지 않는다(시스템만 보냄). -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- PHOTO-폰앱공유(0.4.7): 웹2 [공유]가 넘기는 그림(앱 캐시 share-out/ 한 곳)을 공유 창으로 받은 앱이 읽게 하는 통로.
             내보내지 않고, 공유할 때 그 파일에만 임시 읽기 허락을 준다. 권한 추가 없음. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="kr.or.kptu.work.shareout"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_out_paths" />
        </provider>
        <!-- APP-위젯다시 ①: 홈 화면 '웹2 지금' 위젯(4×2·2×2, 홈 화면 전용). 지난 '오늘'·'텔레그램' 위젯을 합쳐 바꿨다. 권한은 그대로 인터넷 하나. -->
        <receiver
            android:name=".NowWidget"
            android:exported="false"
            android:label="웹2 지금">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_widget_info" />
        </receiver>
    </application>
</manifest>
