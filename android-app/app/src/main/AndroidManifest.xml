<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 기본 권한은 인터넷. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- PHOTO-출처 ①(0.3.9, 명진 결정 10/30): 사진 메뉴 '폰 사진'만 쓰는 사진·동영상 읽기. 처음 사진 메뉴에서 [사진 접근 허용]을 누를 때만 묻는다.
         안드로이드 14+는 '고른 사진만'(부분 허용)도 받는다. 12 이하는 저장소 읽기. 목록·그림은 폰 안에서만 쓰고 서버로 올리지 않는다(PhoneMedia). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- PHOTO-폴더스위치(0.4.1): 사진 [폴더]의 폰 폴더 바꾸기·지우기. 사용자가 설정에서 '미디어 관리 허용'을 켜면 매번 확인 창을 띄우지 않는다(안 켜면 바꿀 때마다 시스템이 묻는다). -->
    <uses-permission android:name="android.permission.MANAGE_MEDIA" tools:ignore="ProtectedPermissions" />
    <!-- APP-스스로업데이트(0.3.8): 이 앱 자신의 새 판(같은 서명, 공개 릴리스)만 설치한다. 처음 한 번 '이 앱에서 설치 허용'을 사용자가 켠다.
         UPDATE_PACKAGES_WITHOUT_USER_ACTION(안드로이드 14+, 일반 권한)은 이 앱이 설치한 이 앱을 확인 없이 업데이트할 때 쓴다. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- MTG-폰녹음(0.3.3): [녹음]에만 쓰는 마이크·앞쪽 서비스(마이크)·알림. 마이크·알림은 처음 녹음할 때만 묻는다. 저장소 권한은 없다(앱 전용 공간만). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:label="웹2"
        android:icon="@drawable/app_icon"
        android:roundIcon="@drawable/app_icon"
        android:theme="@style/AppTheme">
        <!-- singleTask: 로그인 복귀(kptuwork://auth)가 오면 위에 떠 있던 브라우저 탭을 닫고 이 화면으로 돌아온다. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize"
            android:enableOnBackInvokedCallback="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kptuwork" android:host="auth" />
            </intent-filter>
            <!-- 단계 ②: 다른 앱의 [공유]에 "웹2 바구니"로 보인다. 글·링크·사진·파일. 받은 항목의 임시 읽기 권한만 쓴다(저장소 권한 없음). -->
            <intent-filter android:label="웹2 바구니">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="웹2 바구니">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- 단계 ③: 위젯 [로그인] 줄만 여는 화면. 내보내지 않아 다른 앱은 열 수 없다. 그리지 않고 바로 닫는다. -->
        <activity
            android:name=".WidgetLoginActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- MTG-폰녹음: 알림줄 [멈추고 정리]·녹음 시작 인텐트(홈 위젯 [녹음] 칸 자리)를 받는 화면. 내보내지 않아 다른 앱은 열 수 없다. 그리지 않고 바로 닫는다. -->
        <activity
            android:name=".RecordActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- MTG-폰녹음: 화면이 꺼져도 녹음을 잇는 앞쪽 서비스(마이크). 내보내지 않는다. -->
        <service
            android:name=".RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- WIDGET-여러개 ①: 위젯 [사진] 칸. 사진 고르기·카메라 → 공유 받기 길로 정리함. 내보내지 않는다. 저장소·카메라 권한 없음(고른 사진의 임시 읽기, 카메라 앱이 찍어 사진첩에 저장). -->
        <activity
            android:name=".PhotoPickActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- WIDGET-여러개 ①: 한 칸 위젯 기능 고르기. 홈 화면 앱이 열어야 해서 내보내지만 이 앱 위젯 번호의 기능 이름 하나만 저장한다. -->
        <activity
            android:name=".OneWidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/WidgetConfigTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- APP-위젯다시 ②: 빠른 쓰기(4×1·2×1). 서버를 읽지 않는다. -->
        <receiver
            android:name=".QuickWidget"
            android:exported="false"
            android:label="웹2 빠른 쓰기">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_widget_info" />
        </receiver>
        <!-- WIDGET-여러개 ①: 한 칸(1×1). 놓을 때 기능을 고른다. 서버를 읽지 않는다. -->
        <receiver
            android:name=".OneWidget"
            android:exported="false"
            android:label="웹2 한 칸">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/one_widget_info" />
        </receiver>
        <!-- APP-위젯다시 ③: 이번 주(4×2·4×1). 지금 위젯과 같은 위젯 세션·갱신 작업. -->
        <receiver
            android:name=".WeekWidget"
            android:exported="false"
            android:label="웹2 이번 주">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_widget_info" />
        </receiver>
        <!-- WIDGET-여러개 ③: 아스날 다음 경기(2×1). 공개 정적 파일, 로그인 없음. -->
        <receiver
            android:name=".ArsenalWidget"
            android:exported="false"
            android:label="아스날">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/arsenal_widget_info" />
        </receiver>
        <!-- APP-스스로업데이트: PackageInstaller 결과와 새 판으로 바뀜(MY_PACKAGE_REPLACED). 내보내지 않는다(시스템만 보냄). -->
        <receiver
            android:name=".UpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- APP-위젯다시 ①: 홈 화면 '웹2 지금' 위젯(4×2·2×2, 홈 화면 전용). 지난 '오늘'·'텔레그램' 위젯을 합쳐 바꿨다. 권한은 그대로 인터넷 하나. -->
        <receiver
            android:name=".NowWidget"
            android:exported="false"
            android:label="웹2 지금">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_widget_info" />
        </receiver>
    </application>
</manifest>
