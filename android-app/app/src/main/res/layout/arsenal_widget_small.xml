<?xml version="1.0" encoding="utf-8"?>
<!-- APP-위젯아스날맞춤 C: 아스날 2×1. 지난 경기(글자 동그라미 + 두 줄). 결과 가림이면 '결과 가림 · 누르면 보기'(누르면 앱 아스날 화면). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ars_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/ars_circle"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/widget_circle"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:text="A"
        android:textColor="@color/widget_btn_ink"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ars_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="아스날"
            android:textColor="@color/widget_ink"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ars_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="불러오는 중"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
