<?xml version="1.0" encoding="utf-8"?>
<!-- APP-한칸위젯 A(11/22): 한 칸(1×1). 앱 아이콘처럼 정사각 둥근 먹색 칸 + 흰 그림, 이름은 칸 아래 흰 글자 + 옅은 그림자.
     S68-11(11/22): 칸은 그림 한 장(widget_tile_*: 둥근 먹색 칸 + 흰 그림을 한 파일에)이고, 이름 줄 위 남는 공간 전체에
     fitCenter로 그려 홈 화면이 실제로 준 공간에서 가장 큰 정사각이 된다(홈 화면이 알려 주는 칸 크기로 계산하지 않음).
     좌우는 칸 폭의 14%씩 비워(무게 14 : 72 : 14) 앱 아이콘처럼 칸 폭의 72% 안쪽이 된다.
     기능이 달라도 색은 먹색 하나. 놓을 때 고른 기능 하나. 서버 요청 없음. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/one_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="14" />

        <ImageView
            android:id="@+id/one_tile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="72"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_tile_update" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="14" />
    </LinearLayout>

    <TextView
        android:id="@+id/one_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="5dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:textColor="@color/widget_one_label"
        android:textSize="12sp" />
</LinearLayout>
