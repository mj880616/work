<?xml version="1.0" encoding="utf-8"?>
<!-- WIDGET-여러개 ②: 이번 주 일정(4×2). 머리 한 줄 + 줄 8칸까지(오늘~일요일). 줄을 누르면 앱 달력의 그 날. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/week_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/week_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/week_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="새로고침"
            android:minHeight="32dp"
            android:minWidth="32dp"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:text="↻"
            android:textColor="@color/widget_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView android:id="@+id/week_row0" style="@style/WidgetRow" />
    <TextView android:id="@+id/week_row1" style="@style/WidgetRow" />
    <TextView android:id="@+id/week_row2" style="@style/WidgetRow" />
    <TextView android:id="@+id/week_row3" style="@style/WidgetRow" />
    <TextView android:id="@+id/week_row4" style="@style/WidgetRow" />
    <TextView android:id="@+id/week_row5" style="@style/WidgetRow" />
    <TextView android:id="@+id/week_row6" style="@style/WidgetRow" />
    <TextView android:id="@+id/week_row7" style="@style/WidgetRow" />

    <TextView
        android:id="@+id/week_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/widget_muted"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
