<?xml version="1.0" encoding="utf-8"?>
<!-- APP-위젯다시 ③: '이번 주'(4×2). 요일 칸 7개(일정 수 + S68-06 그날 첫 일정 제목 앞부분 한 줄, 오늘 칸은 먹색 바탕) + 가장 큰 일·주간 보고일(명진 화면은 상집 보고일, S68-02)·일정 몰린 날. 늘 이번 주부터, 머리 줄 ‹ ›로 앞뒤 주(S68-12). 놓자마자 '불러오는 중'. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/week_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <!-- S68-12: 지난주로(‹)·다음 주로(›). 범위 끝이면 자리만 남기고 숨김. S68-22(명진 11/22 18:01 "화살표 크기 너무 작음"): 26sp 먹색, 누르는 자리 40×36dp. -->
        <TextView
            android:id="@+id/week_prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:singleLine="true"
            android:gravity="center"
            android:minWidth="40dp"
            android:minHeight="36dp"
            android:textColor="@color/widget_ink"
            android:textSize="26sp"
            android:paddingStart="0dp"
            android:paddingEnd="6dp"
            android:contentDescription="지난주로" />
        <TextView
            android:id="@+id/week_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="이번 주"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/week_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/week_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↻"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_muted"
            android:textSize="13sp"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:contentDescription="새로고침" />
        <TextView
            android:id="@+id/week_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:singleLine="true"
            android:gravity="center"
            android:minWidth="40dp"
            android:minHeight="36dp"
            android:textColor="@color/widget_ink"
            android:textSize="26sp"
            android:paddingStart="6dp"
            android:paddingEnd="0dp"
            android:contentDescription="다음 주로" />
    </LinearLayout>
