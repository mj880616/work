    <!-- S68-51(사용자 11/23 "일정 그냥 다 보여줘 뭘 또 4개 몰림이야"): 주간 요약 줄(가장 큰 일·보고일·몰린 날)을 없애고 아래 칸은 늘 하루 목록.
         머리 줄(그 날·일정 수·할 일 수) + [열기] + 그 날 줄 전부(줄임 없이, 남은 높이 안에서 스크롤). 다가오는 일·보고일은 목록 끝 줄. -->
    <LinearLayout
        android:id="@+id/week_sel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/week_sel_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="@color/widget_ink"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/week_sel_open"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_todo"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:text="열기 ›"
                android:textColor="@color/widget_todo_ink"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <ListView
            android:id="@+id/week_sel_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="vertical" />
    </LinearLayout>
    <TextView
        android:id="@+id/week_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="불러오는 중"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/widget_muted"
        android:textSize="11sp"
        android:paddingTop="2dp" />
</LinearLayout>
