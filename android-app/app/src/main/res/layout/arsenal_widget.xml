<?xml version="1.0" encoding="utf-8"?>
<!-- APP-아스날위젯알차게(S48-55): 아스날 4×2(처음 놓는 크기). 빈칸 없이 위에서부터
     ① 머리줄: ARS·상대 줄임 글자 동그라미 + 홈/원정·대회 표 + 다음 경기(또는 방금 끝난 경기 결과) + D-n/결과 표
     ② 끝나는 시각 → 첫 일정(잠 n시간) 또는 골 넣은 선수 ③ 최근 5경기 칸 + 지난 경기 한 줄
     ④ 지난 경기 리뷰 첫 문장(누르면 그 리뷰, 높은 칸에서만) ⑤ 그다음 경기들(대회 표·홈/원정·상대) ⑥ [달력에 넣기][FotMob로 보기].
     RemoteViews 허용 부품(LinearLayout·TextView)만 쓴다(check-widget-layouts.py). 누르면 앱 아스날 화면. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ars_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ars_home_code"
            style="@style/WidgetTeamCode"
            android:background="@drawable/widget_circle_ars"
            android:text="ARS"
            android:textColor="@color/widget_req_ink" />

        <TextView
            android:id="@+id/ars_circle"
            style="@style/WidgetTeamCode"
            android:layout_marginStart="2dp"
            android:text="A" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ars_top"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="아스날"
                android:textColor="@color/widget_ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ars_tag"
                    style="@style/WidgetTag"
                    android:layout_marginEnd="4dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ars_side"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:singleLine="true"
                    android:textColor="@color/widget_accent"
                    android:textSize="10sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/ars_sub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/widget_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/ars_dday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_badge_todo"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:textColor="@color/widget_todo_ink"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ars_bottom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="불러오는 중"
                android:textColor="@color/widget_ink"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/ars_sleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:singleLine="true"
                android:textColor="@color/widget_req_ink"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/ars_f0" style="@style/WidgetFormCell" android:visibility="gone" />
            <TextView android:id="@+id/ars_f1" style="@style/WidgetFormCell" android:visibility="gone" />
            <TextView android:id="@+id/ars_f2" style="@style/WidgetFormCell" android:visibility="gone" />
            <TextView android:id="@+id/ars_f3" style="@style/WidgetFormCell" android:visibility="gone" />
            <TextView android:id="@+id/ars_f4" style="@style/WidgetFormCell" android:visibility="gone" />
            <TextView
                android:id="@+id/ars_formnote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/widget_muted"
                android:textSize="10sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/ars_last"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/widget_ink"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ars_review"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:clickable="true"
            android:ellipsize="end"
            android:focusable="true"
            android:singleLine="true"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/ars_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/ars_next_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:singleLine="true"
                android:text="이후"
                android:textColor="@color/widget_muted"
                android:textSize="10sp" />
            <LinearLayout
                android:id="@+id/ars_n0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView android:id="@+id/ars_n0_tag" style="@style/WidgetTag" android:text="PL" />
                <TextView android:id="@+id/ars_n0_text" style="@style/WidgetMini" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ars_n1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView android:id="@+id/ars_n1_tag" style="@style/WidgetTag" android:text="PL" />
                <TextView android:id="@+id/ars_n1_text" style="@style/WidgetMini" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ars_n2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <TextView android:id="@+id/ars_n2_tag" style="@style/WidgetTag" android:text="PL" />
                <TextView android:id="@+id/ars_n2_text" style="@style/WidgetMini" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ars_cal"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:singleLine="true"
            android:text="달력에 넣기"
            android:textColor="@color/widget_btn_ink"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ars_fotmob"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:singleLine="true"
            android:text="FotMob로 보기"
            android:textColor="@color/widget_btn_ink"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
