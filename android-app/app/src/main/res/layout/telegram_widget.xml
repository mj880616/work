<?xml version="1.0" encoding="utf-8"?>
<!-- WIDGET-여러개 ③: 텔레그램 새 소식(4×2, 운영자 전용). 머리 '새 소식 n · 요청 n' + 최근 방 세 줄. 줄을 누르면 그 방. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tg_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tg_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:textColor="@color/widget_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tg_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="새로고침"
            android:minHeight="32dp"
            android:minWidth="32dp"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:text="↻"
            android:textColor="@color/widget_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView android:id="@+id/tg_row0" style="@style/WidgetRow" />
    <TextView android:id="@+id/tg_row1" style="@style/WidgetRow" />
    <TextView android:id="@+id/tg_row2" style="@style/WidgetRow" />

    <TextView
        android:id="@+id/tg_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/widget_muted"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
