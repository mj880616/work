<?xml version="1.0" encoding="utf-8"?>
<!-- APP-위젯다시 ②: 빠른 쓰기(4×1). 단추 셋([할 일] [노트] [사진]).
     APP-위젯먹색 S68-06(11/22): 단추는 한 칸 위젯과 같은 정사각 둥근 먹색 칸 + 흰 그림, 이름은 칸 아래.
     S68-11(11/22): 칸은 그림 한 장(widget_tile_*)을 이름 줄 위 남는 공간 전체에 fitCenter로 그려 위젯이 실제로 받은 공간에서
     가장 큰 정사각이 된다(크기 계산 없음). 좌우는 칸 폭의 14%씩 비운다(무게 14 : 72 : 14).
     이 위젯은 종이색 바탕(widget_bg) 안에 그리므로 이름은 먹색 글자(widget_ink, 그림자 없음). 누를 때 물결은 칸 전체(widget_day_plain). 서버 요청 없음. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:padding="4dp">
    <LinearLayout
        android:id="@+id/quick_cell0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_day_plain"
        android:clickable="true"
        android:contentDescription="할 일"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="40dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="14" />

            <ImageView
                android:id="@+id/quick_tile0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="72"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_tile_task" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="14" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="할 일"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            android:textSize="11sp"
            android:paddingTop="2dp" />
    </LinearLayout>
    <TextView
        android:layout_width="6dp"
        android:layout_height="1dp" />
    <LinearLayout
        android:id="@+id/quick_cell1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_day_plain"
        android:clickable="true"
        android:contentDescription="노트"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="40dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="14" />

            <ImageView
                android:id="@+id/quick_tile1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="72"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_tile_note" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="14" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="노트"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            android:textSize="11sp"
            android:paddingTop="2dp" />
    </LinearLayout>
    <TextView
        android:layout_width="6dp"
        android:layout_height="1dp" />
    <LinearLayout
        android:id="@+id/quick_cell2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_day_plain"
        android:clickable="true"
        android:contentDescription="사진"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="40dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="14" />

            <ImageView
                android:id="@+id/quick_tile2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="72"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_tile_photo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="14" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="사진"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            android:textSize="11sp"
            android:paddingTop="2dp" />
    </LinearLayout>
</LinearLayout>
