<?xml version="1.0" encoding="utf-8"?>
<!-- APP-위젯다시 ①: '지금'(4×2). 다음 일정 크게(시각·제목·남은 시간) + 그다음 한 줄 + 처리할 것 세 줄. 놓자마자 '불러오는 중'. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/now_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/now_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="다음 일정"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/now_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/now_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↻"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_muted"
            android:textSize="13sp"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:contentDescription="새로고침" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/now_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/now_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/now_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            android:textSize="15sp"
            android:layout_weight="1"
            android:paddingStart="8dp" />
    </LinearLayout>
    <TextView
        android:id="@+id/now_after"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/widget_muted"
        android:textSize="11sp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:background="@color/widget_line" />
    <LinearLayout
        android:id="@+id/now_row_asks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:id="@+id/now_asks_n"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_req_ink"
            android:textSize="11sp"
            android:textStyle="bold"
            android:minWidth="22dp"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:background="@drawable/widget_badge_zero" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="나한테 온 요청"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="8dp" />
        <TextView
            android:id="@+id/now_asks_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"
            android:layout_weight="1"
            android:paddingStart="8dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/now_row_todo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:id="@+id/now_todo_n"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_todo_ink"
            android:textSize="11sp"
            android:textStyle="bold"
            android:minWidth="22dp"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:background="@drawable/widget_badge_zero" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="챙길 것"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="8dp" />
        <TextView
            android:id="@+id/now_todo_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"
            android:layout_weight="1"
            android:paddingStart="8dp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/now_row_due"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:id="@+id/now_due_n"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_todo_ink"
            android:textSize="11sp"
            android:textStyle="bold"
            android:minWidth="22dp"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:background="@drawable/widget_badge_zero" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오늘 기한 할 일"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_ink"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingStart="8dp" />
        <TextView
            android:id="@+id/now_due_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"
            android:layout_weight="1"
            android:paddingStart="8dp" />
    </LinearLayout>
    <TextView
        android:id="@+id/now_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="불러오는 중"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/widget_muted"
        android:textSize="11sp"
        android:paddingTop="2dp" />
</LinearLayout>
