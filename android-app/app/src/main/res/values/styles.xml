<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 첫 화면이 하얗게 번쩍이지 않도록 바탕을 웹 바탕색으로 둔다. 바 색·아이콘 색은 MainActivity가 정한다. -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/web_bg</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <!-- 위젯 한 줄: 시각 + 제목. 넘치면 끝을 줄인다. -->
    <style name="WidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">26dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textSize">12sp</item>
        <item name="android:visibility">gone</item>
    </style>
    <!-- WIDGET-여러개 ①: 한 칸 위젯 기능 고르기 작은 창(밝은·어두운 모드). -->
    <style name="WidgetConfigTheme" parent="android:style/Theme.DeviceDefault.Light.Dialog" />
    <!-- APP-위젯빠른쓰기: 위젯 빠른 쓰기 작은 창(아래에 붙는 작은 창, 밝은 모드). 어두운 모드는 values-night. -->
    <style name="QuickWriteTheme" parent="android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar">
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>
    <!-- APP-위젯아스날맞춤 C: 4×1 최근 다섯 경기 승·무·패 동그라미 한 개(바탕은 ArsenalWidget이 승·무·패 색으로). -->
    <style name="WidgetFormDot">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/widget_form_draw</item>
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- APP-아스날위젯알차게: 4×2 최근 다섯 경기 칸(조금 작게). 바탕은 ArsenalWidget이 승·무·패 색으로. -->
    <style name="WidgetFormCell" parent="WidgetFormDot">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:textSize">10sp</item>
    </style>
    <!-- 팀 줄임 글자 동그라미(엠블럼 그림 대신). -->
    <style name="WidgetTeamCode">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
        <item name="android:background">@drawable/widget_circle</item>
        <item name="android:textColor">@color/widget_btn_ink</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <!-- 대회 작은 표(PL·UCL·EFL·FA). -->
    <style name="WidgetTag">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/widget_tag</item>
        <item name="android:paddingStart">3dp</item>
        <item name="android:paddingEnd">3dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/widget_zero_ink</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- 다음 3경기 한 칸 글(작게). -->
    <style name="WidgetMini">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/widget_muted</item>
        <item name="android:textSize">10sp</item>
    </style>
</resources>
